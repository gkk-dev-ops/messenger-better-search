{
  "manifest_version": 3,
  "name": "Messenger Memory",
  "version": "0.1.0",
  "description": "Local-first Messenger archive, search and optional AI enrichment.",
  "permissions": ["storage", "unlimitedStorage", "tabs"],
  "host_permissions": [
    "https://www.messenger.com/*",
    "https://www.facebook.com/messages/*"
  ],
  "optional_host_permissions": [
    "https://api.elevenlabs.io/*",
    "https://api.openai.com/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "src/popup.html", "default_title": "Messenger Memory" },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.messenger.com/*", "https://www.facebook.com/messages/*"],
      "js": ["src/date-utils.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/search.html", "src/styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
